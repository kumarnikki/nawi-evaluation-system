# Supabase configuration (optional — app runs in mock/IndexedDB mode without these)
# Get these from your Supabase project settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Without the above, the app auto-detects mock mode and uses localStorage.
# Demo accounts work out of the box with no configuration.
